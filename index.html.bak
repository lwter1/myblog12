<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的个人主页</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Inter 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            @apply bg-gray-50 text-gray-800;
        }
        .bg-pattern {
            background-image: linear-gradient(to right, #e2e8f0 1px, transparent 1px),
                              linear-gradient(to bottom, #e2e8f0 1px, transparent 1px);
            background-size: 20px 20px;
        }
    </style>
</head>
<body class="bg-pattern min-h-screen flex items-center justify-center p-4">

    <div class="bg-white rounded-3xl shadow-2xl p-6 md:p-10 w-full max-w-4xl mx-auto border border-gray-200 transform transition-all duration-300 hover:scale-105">
        <!-- 头像和基本信息 -->
        <header class="flex flex-col items-center text-center">
            <!-- 替换为你的头像图片 URL -->
            <img src="https://placehold.co/120x120/1a202c/ffffff?text=YOU" alt="我的头像" class="w-24 h-24 md:w-32 md:h-32 rounded-full ring-4 ring-blue-500 mb-4 transition-all duration-300 hover:ring-8">
            <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-2">你的名字</h1>
            <p class="text-lg md:text-xl text-gray-600 mb-6">一行简介，比如：一位热情的 Web 开发者 | 摄影爱好者</p>
        </header>

        <!-- 关于我 -->
        <section class="mt-8">
            <h2 class="text-2xl font-semibold text-gray-900 mb-4 border-b-2 border-blue-500 pb-2">关于我</h2>
            <p class="text-gray-700 leading-relaxed text-base md:text-lg">
                在这里写一段关于你自己的详细介绍。你可以谈论你的背景、兴趣、技能、
                或者你正在做的事情。这段文字可以是你个性的延伸，让访客更好地了解你。
                例如：我专注于前端开发，热爱使用 React 和 Vue 构建现代化的用户界面。
                业余时间，我喜欢徒步旅行和阅读科幻小说。
            </p>
        </section>

        <!-- 技能 -->
        <section class="mt-8">
            <h2 class="text-2xl font-semibold text-gray-900 mb-4 border-b-2 border-blue-500 pb-2">我的技能</h2>
            <div class="flex flex-wrap gap-2 md:gap-3">
                <span class="bg-blue-100 text-blue-800 text-sm md:text-base font-medium px-3 md:px-4 py-1.5 rounded-full shadow-sm">HTML5</span>
                <span class="bg-blue-100 text-blue-800 text-sm md:text-base font-medium px-3 md:px-4 py-1.5 rounded-full shadow-sm">CSS3</span>
                <span class="bg-blue-100 text-blue-800 text-sm md:text-base font-medium px-3 md:px-4 py-1.5 rounded-full shadow-sm">JavaScript (ES6+)</span>
                <span class="bg-blue-100 text-blue-800 text-sm md:text-base font-medium px-3 md:px-4 py-1.5 rounded-full shadow-sm">React</span>
                <span class="bg-blue-100 text-blue-800 text-sm md:text-base font-medium px-3 md:px-4 py-1.5 rounded-full shadow-sm">Tailwind CSS</span>
                <span class="bg-blue-100 text-blue-800 text-sm md:text-base font-medium px-3 md:px-4 py-1.5 rounded-full shadow-sm">Node.js</span>
                <span class="bg-blue-100 text-blue-800 text-sm md:text-base font-medium px-3 md:px-4 py-1.5 rounded-full shadow-sm">Python</span>
                <!-- 你可以添加更多技能标签 -->
            </div>
        </section>
        
        <!-- 社交媒体链接 -->
        <section class="mt-8">
            <h2 class="text-2xl font-semibold text-gray-900 mb-4 border-b-2 border-blue-500 pb-2">联系我</h2>
            <div class="flex flex-wrap gap-4 justify-center md:justify-start">
                <!-- GitHub -->
                <a href="https://github.com/你的用户名" target="_blank" class="flex items-center space-x-2 bg-gray-800 text-white px-4 py-2 rounded-full shadow-md hover:bg-gray-900 transition-colors duration-200">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.83 9.504.5.092.682-.217.682-.483 0-.237-.008-.865-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.618.069-.606.069-.606 1.003.07 1.531 1.032 1.531 1.032.892 1.529 2.341 1.085 2.915.829.091-.645.351-1.085.636-1.336-2.22-.249-4.555-1.114-4.555-4.954 0-1.091.39-1.984 1.029-2.68a3.633 3.633 0 01.1-.926s.831-.271 2.753 1.05c1.758-.485 3.66-.485 5.418 0 1.921-1.321 2.752-1.05 2.752-1.05.215.549.333 1.2.36 1.353.64.696 1.029 1.59 1.029 2.68 0 3.84-2.339 4.691-4.566 4.939.359.31.678.921.678 1.856 0 1.336-.012 2.419-.012 2.747 0 .268.18.577.688.484C19.137 20.2 22 16.44 22 12.017 22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
                    <span>GitHub</span>
                </a>
                <!-- LinkedIn -->
                <a href="https://linkedin.com/in/你的用户名" target="_blank" class="flex items-center space-x-2 bg-blue-700 text-white px-4 py-2 rounded-full shadow-md hover:bg-blue-800 transition-colors duration-200">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38-.112-2.5 1.119-2.5s2.48 1.119 2.48 2.5zM.019 8.24h4.942v15.93h-4.942v-15.93zM24 16.634c0-4.068-2.753-6.19-5.467-6.19-2.636 0-3.364 1.77-3.364 1.77v-1.53h-4.941s.06 1.734 0 3.737c0 0 .151 3.52 0 6.643v4.064h4.941v-3.834c0-2.09.43-4.102 2.924-4.102 2.162 0 2.434 2.131 2.434 4.35v3.586h4.941v-4.545z"/></svg>
                    <span>LinkedIn</span>
                </a>
                <!-- 邮箱 -->
                <a href="mailto:你的邮箱@example.com" class="flex items-center space-x-2 bg-red-500 text-white px-4 py-2 rounded-full shadow-md hover:bg-red-600 transition-colors duration-200">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm0 1.5a8.25 8.25 0 110 16.5 8.25 8.25 0 010-16.5zM12 6a6 6 0 00-6 6c0 3.313 2.687 6 6 6s6-2.687 6-6a6 6 0 00-6-6zm0 1.5a4.5 4.5 0 014.5 4.5c0 2.485-2.015 4.5-4.5 4.5S7.5 14.485 7.5 12A4.5 4.5 0 0112 7.5z"/></svg>
                    <span>邮箱</span>
                </a>
                <!-- 你可以添加更多社交媒体链接 -->
            </div>
        </section>

        <!-- 底部版权信息 -->
        <footer class="mt-10 text-center text-gray-500 text-sm">
            <p>&copy; 2024 你的名字. 保留所有权利。</p>
        </footer>
    </div>
</body>
</html>

